{
  "name": "@tweakpad/ui",
  "version": "0.1.0",
  "description": "LitElement implementation of the Tweakpad UI Foundation and Component Library specifications.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/register.ts"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \".storybook/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,css,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \".storybook/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,css,html,md}\"",
    "lint": "npm run format:check && npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "BROWSER=chromium node scripts/browser-smoke.mjs && BROWSER=firefox node scripts/browser-smoke.mjs && BROWSER=webkit node scripts/browser-smoke.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "verify:phase-1": "node scripts/verify-phase-1.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "globals": "^16.4.0",
    "playwright": "^1.63.0",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
