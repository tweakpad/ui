#!/bin/sh
# Runs CI's lint, type check and tests, then builds and checks the bundle size budgets CI checks,
# before anything leaves this machine (about three minutes). Skip once with `git push --no-verify`.
# Git clients started from the desktop run hooks with a minimal PATH: add the usual Node locations.
command -v npm >/dev/null 2>&1 || PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$PATH"
npm run --silent check && exec npm run --silent size:check
